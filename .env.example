# =============================================================================
# TrustScan AI — environment configuration
# Copy to `.env` and adjust values. Never commit the real `.env`.
# =============================================================================

# --- Compose / infrastructure ------------------------------------------------
POSTGRES_USER=trustscan
POSTGRES_PASSWORD=trustscan
POSTGRES_DB=trustscan
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Application -------------------------------------------------------------
# development | test | production
TRUSTSCAN_ENVIRONMENT=development
TRUSTSCAN_DEBUG=false
TRUSTSCAN_APP_NAME=TrustScan AI
TRUSTSCAN_API_V1_PREFIX=/api/v1
TRUSTSCAN_FRONTEND_URL=http://localhost:3000
TRUSTSCAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRUSTSCAN_SECRET_KEY=change-me-to-a-long-random-string-at-least-48-characters
TRUSTSCAN_ACCESS_TOKEN_MINUTES=15
TRUSTSCAN_REFRESH_TOKEN_DAYS=30
TRUSTSCAN_PASSWORD_MIN_LENGTH=10
# Must be true (HTTPS only) in production.
TRUSTSCAN_COOKIE_SECURE=false
TRUSTSCAN_COOKIE_DOMAIN=
TRUSTSCAN_RATE_LIMIT_ENABLED=true
TRUSTSCAN_AUTH_RATE_LIMIT_PER_MINUTE=12
TRUSTSCAN_INVESTIGATION_RATE_LIMIT_PER_MINUTE=20

# --- Database ----------------------------------------------------------------
# Local (outside Docker):
TRUSTSCAN_DATABASE_URL=postgresql+asyncpg://trustscan:trustscan@localhost:5432/trustscan
# SQLite fallback for a zero-dependency demo:
# TRUSTSCAN_DATABASE_URL=sqlite+aiosqlite:///./trustscan.db
TRUSTSCAN_DATABASE_ECHO=false
# Let the app create tables on startup. Disable in production and use Alembic.
TRUSTSCAN_AUTO_CREATE_TABLES=true

# --- Uploads -----------------------------------------------------------------
TRUSTSCAN_UPLOAD_DIR=uploads
TRUSTSCAN_MAX_UPLOAD_SIZE_MB=10
TRUSTSCAN_MAX_TEXT_CHARACTERS=20000
TRUSTSCAN_RETENTION_DAYS=90

# --- LLM ---------------------------------------------------------------------
# Leave TRUSTSCAN_LLM_API_KEY empty to run the deterministic fallback engine.
TRUSTSCAN_LLM_ENABLED=true
TRUSTSCAN_LLM_PROVIDER=openrouter
TRUSTSCAN_LLM_API_KEY=
TRUSTSCAN_LLM_BASE_URL=https://openrouter.ai/api/v1
TRUSTSCAN_LLM_MODEL=openrouter/free
TRUSTSCAN_LLM_TIMEOUT_SECONDS=45
TRUSTSCAN_LLM_MAX_RETRIES=2

# --- Embeddings / RAG --------------------------------------------------------
# openai | sentence-transformers | hash
TRUSTSCAN_EMBEDDING_PROVIDER=hash
TRUSTSCAN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TRUSTSCAN_EMBEDDING_DIM=384
TRUSTSCAN_RAG_TOP_K=4
TRUSTSCAN_RAG_MIN_SCORE=0.05
TRUSTSCAN_KNOWLEDGE_DIR=data/knowledge_base
TRUSTSCAN_SEED_KNOWLEDGE_ON_STARTUP=true

# --- OCR ---------------------------------------------------------------------
TRUSTSCAN_OCR_ENABLED=true
# TRUSTSCAN_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Pipeline ----------------------------------------------------------------
# background (production) | inline (tests / single-process demos)
TRUSTSCAN_PIPELINE_MODE=background
TRUSTSCAN_PIPELINE_TIMEOUT_SECONDS=180

# --- Observability -----------------------------------------------------------
TRUSTSCAN_LOG_LEVEL=INFO
TRUSTSCAN_LOG_JSON=false
TRUSTSCAN_SENTRY_DSN=
